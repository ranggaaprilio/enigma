POSTGRES_USER=execute
POSTGRES_PASSWORD=execute
POSTGRES_DB=execute_dashboard

DATABASE_URL=postgresql+asyncpg://execute:execute@postgres:5432/execute_dashboard
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required (docker-compose refuses to start without it). At least 32 characters outside
# ENVIRONMENT=local. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET_KEY=
AUTH_COOKIE_NAME=execute_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Required, and must be a valid Fernet key. Encrypts stored credentials (workspace env vars,
# git tokens/SSH keys, the LLM API key) -- changing it makes existing ones undecryptable.
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WORKSPACE_ENV_ENCRYPTION_KEY=

# Anything other than "local" refuses to boot with default/weak secrets, requires METRICS_TOKEN,
# and forces Secure cookies (serve the API over HTTPS/WSS).
# ENVIRONMENT=production
# METRICS_TOKEN=
# Graceful shutdown: after SIGTERM, /ready answers 503 for the drain delay, then in-flight runs
# get the grace window before being cancelled and recorded as interrupted_by_restart.
# SHUTDOWN_DRAIN_DELAY_SECONDS=5
# SHUTDOWN_RUN_GRACE_SECONDS=15

# Where runs execute (Epic 02). "inline" (default): inside the API process, one replica only.
# "queue": the API enqueues run ids on Redis and `worker` processes execute them
# (`podman compose --profile queue up`); run events and stop signals travel over Redis pub/sub.
# Switch only while no runs are active.
# RUN_EXECUTION_MODE=inline
# RUN_QUEUE_NAME=enigma:runs
# WORKER_MAX_JOBS=10            # concurrent runs per worker process
# WORKER_MAX_TRIES=3            # deliveries before a run that never started is dead-lettered
# AGENT_RUN_TIMEOUT_SECONDS=7200
# WORKER_JOB_TIMEOUT_SECONDS=7500   # keep above AGENT_RUN_TIMEOUT_SECONDS
# WORKER_ID=                    # defaults to the hostname. Never share one across live workers:
#                               # a worker's restart sweep ends every active run stamped with its id.
# In queue mode Redis carries jobs and run events: use auth + TLS (rediss://) on a private network.

# Data layer (Epic 05). Each process may open DB_POOL_SIZE + DB_MAX_OVERFLOW connections; keep
# (API replicas + workers) x that sum under Postgres max_connections with headroom. The compose
# worker uses WORKER_DB_POOL_SIZE / WORKER_DB_MAX_OVERFLOW (3 / 2) instead.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# Behind PgBouncer (`--profile pgbouncer`): point DATABASE_URL at pgbouncer:5432 and set this;
# the app then keeps no pool of its own and caches no prepared statements.
# DB_PGBOUNCER=false
# Redis calls fail after these instead of hanging on a dead or partitioned Redis.
# REDIS_SOCKET_TIMEOUT_SECONDS=5
# REDIS_CONNECT_TIMEOUT_SECONDS=5
# Retention in days; 0 (default) keeps forever. Deletion is permanent. Suggested: 30/30/30/90.
# Token and cost totals live on agent_runs and survive event pruning.
# RETENTION_AGENT_EVENTS_DAYS=0
# RETENTION_COMMAND_OUTPUT_DAYS=0
# RETENTION_READ_NOTIFICATIONS_DAYS=0
# RETENTION_NOTIFICATIONS_DAYS=0        # budget warnings are always kept (their de-dupe record)
# RETENTION_INTERVAL_SECONDS=3600
# Fair use (Epic 06). Per-(user, workspace) rate limits; a refusal is 429 + Retry-After.
# SPEC_RUN_RATE_LIMIT_ATTEMPTS=10
# SPEC_RUN_RATE_LIMIT_WINDOW_SECONDS=60
# SANDBOX_RATE_LIMIT_ATTEMPTS=20       # uploads/writes, editor/dev-server/service start, terminals
# SANDBOX_RATE_LIMIT_WINDOW_SECONDS=60
# Concurrent agent-run caps (0 = off). Team-less workspaces only count toward the global cap.
# RUN_CAP_PER_TEAM=0
# RUN_CAP_GLOBAL=0
# Queue mode: refuse new runs (503) while this many wait for a worker (0 = off).
# RUN_QUEUE_MAX_DEPTH=0
# RUN_CAPACITY_RETRY_AFTER_SECONDS=15

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# For the preview/dev-server feature, use a snapshot with `mise` pre-installed.
# Build one with daytona/build-snapshot.sh (image: sandbox/Dockerfile), then set its name here.
# The stock daytonaio/sandbox image lacks mise and fails the runtime curl install.
DAYTONA_DEFAULT_SNAPSHOT=
DAYTONA_DEFAULT_LANGUAGE=python
# Idle sandboxes stop after this long (0 = never), on Daytona and local Docker alike.
# (DAYTONA_AUTO_STOP_MINUTES is still accepted.)
SANDBOX_AUTO_STOP_MINUTES=30
DAYTONA_PROVISION_TIMEOUT_SECONDS=120
DAYTONA_PREVIEW_URL_TTL_SECONDS=3600
# Production example: https://preview.example.com with *.preview.example.com DNS/TLS.
# (DAYTONA_PREVIEW_PROXY_* still accepted for one release; logged as deprecated.)
PREVIEW_PROXY_BASE_URL=http://localhost:8001
PREVIEW_PROXY_TTL_SECONDS=3600
# Sandbox network egress. Default opens general outbound access so sandboxes can
# reach external services (package registries, APIs, managed DBs, etc).
# SECURITY: enigma runs AI agents and previewed code in these sandboxes — open
# egress lets that code reach any host. Set BLOCK_ALL=true to isolate (on local Docker the
# sandbox network becomes internal; previews still work). DAYTONA_NETWORK_* still accepted
# for one release (logged as deprecated).
SANDBOX_NETWORK_BLOCK_ALL=false
# Comma-separated IPv4 CIDRs to allow (only effective when BLOCK_ALL=false;
# empty = unrestricted). Note: CIDR only, no DNS — for managed DBs whose IPs
# rotate (RDS/ES), allow the VPC CIDR, not per-host IPs. Example: 10.0.0.0/16
# Git hosts must be reachable from the sandbox: HTTPS (443) for token auth and
# SSH (22) for deploy keys, plus github.com for workspace-template clones.
# Daytona only for now: local Docker has no allow list yet (open or BLOCK_ALL).
SANDBOX_NETWORK_ALLOW_LIST=

# Local Docker/Podman sandboxes instead of (or alongside) Daytona. Full guide:
# docs/self-host-docker.md. Opt in with
# `podman compose -f docker-compose.yml -f docker-compose.sandbox.yml up` after building the
# image with ./sandbox/build-local-image.sh. Each sandbox gets its own network; the backend
# attaches the preview proxy to each one, and idle sandboxes are stopped (kept) and wake on use.
# No Daytona subscription: leave DAYTONA_API_KEY empty; new workspaces then go to Docker.
# SECURITY: the backend and worker get the Docker socket, which is root-equivalent on the host.
# SANDBOX_RUNTIME_DEFAULT=daytona      # provider for NEW workspaces: daytona | docker
#                                      # docker also turns on the upkeep loop (idle stop, orphans)
#                                      # and REQUIRES METRICS_TOKEN (the proxy is reachable from
#                                      # every sandbox; its /health and /metrics are token-gated)
# DOCKER_SINGLE_HOST=false             # queue mode only: set true when API, workers and proxy
#                                      # share one daemon; Docker workspaces are refused without it
# DOCKER_SOCKET=/var/run/docker.sock   # compose only: socket mounted into backend + worker
# DOCKER_HOST=                         # backend outside compose: empty = default unix socket
# DOCKER_SANDBOX_IMAGE=enigma-sandbox:latest
# DOCKER_SANDBOX_USER=daytona          # must exist in the image; root is refused
# DOCKER_SANDBOX_CPUS=2
# DOCKER_SANDBOX_MEMORY_MB=4096        # swap is capped at the same value
# DOCKER_SANDBOX_PIDS_LIMIT=4096
# DOCKER_SANDBOX_TMP_MB=1024           # /tmp is a tmpfs of this size (counts against memory)
# DOCKER_SANDBOX_NOFILE=65536          # open-file limit
# DOCKER_SANDBOX_SUBNET_POOL=10.213.0.0/16   # per-sandbox networks are /28s from this pool
# DOCKER_PREVIEW_PROXY_HOST=preview-proxy    # the proxy's name on every sandbox network
# DOCKER_PREVIEW_PROXY_LABEL=enigma.preview-proxy=1   # how the backend finds proxy containers
# DOCKER_REAPER_INTERVAL_SECONDS=60    # upkeep pass: proxy re-attach + idle auto-stop
# SANDBOX_BUSY_MAX_MINUTES=240        # a sandbox with a live exec/terminal is spared only this long
# DOCKER_MAX_CONCURRENT_EXECS=64     # commands in flight per process (one thread each)
# DOCKER_PROVISION_TIMEOUT_SECONDS=60

# Set to false when using a Daytona snapshot with code-server pre-installed
# (see sandbox/Dockerfile); leave true/unset to let the editor curl-install it
# at runtime on stock images.
EDITOR_AUTO_INSTALL=false

# How long the one-shot grant in the editor iframe's URL stays valid. It only has to survive the
# first navigation, after which the proxy's host-scoped cookie takes over.
EDITOR_PRIME_TTL_SECONDS=120

# WARNING: false lets the agent execute arbitrary shell commands, including operators,
# absolute paths, package managers, and destructive commands. Use only in isolated sandboxes.
AGENT_COMMAND_DENY_DANGEROUS=true

# --- Run configuration: user-authored commands ------------------------------
# Budget for a registry command (install / migrate / dev / test / ...). These are
# owner-authored and can be slow — `pnpm install` and `alembic upgrade head` cannot
# finish inside the 20s AGENT_COMMAND_TIMEOUT_SECONDS the agent tooling uses, so they
# get their own, much larger budget. A command may override this per entry; the
# override is clamped to COMMAND_RUN_MAX_TIMEOUT_SECONDS.
COMMAND_RUN_TIMEOUT_SECONDS=900
COMMAND_RUN_MAX_TIMEOUT_SECONDS=3600
# Command runs are fire-and-forget background tasks against the sandbox with no
# concurrency cap, so creation is throttled per (user, workspace).
COMMAND_RUN_RATE_LIMIT_ATTEMPTS=30
COMMAND_RUN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Multi-service preview (Epic 11) -----------------------------------------
# A sandbox is a shared, sized resource: cap how many services can run at once.
MAX_RUNNING_SERVICES_PER_WORKSPACE=4
# Auto-resume backoff so a crash-looping service is not relaunched every poll tick.
SERVICE_RELAUNCH_MIN_INTERVAL_SECONDS=60
# After this long since launch, a service with no bound port yet is reported "running"
# instead of "starting" forever.
SERVICE_START_GRACE_SECONDS=90
# How long a single log-stream WebSocket keeps its sandbox `tail -F` alive before the
# client must reconnect (it gets a fresh replay).
SERVICE_LOG_STREAM_TIMEOUT_SECONDS=3600

VITE_API_BASE_URL=http://localhost:8000

# --- LLM (fallback) ---------------------------------------------------------------------
# These are the FALLBACK. A platform owner can set the LLM base URL / model / API key at
# runtime from the UI (Settings -> Language model), which stores a single encrypted row that
# overrides everything below, with no restart. Leave these set for a first boot, or for a
# deployment that never wants a UI-managed configuration.
#
# Agent engine. Use "openhands" for OpenHands SDK with any OpenAI-compatible API.
AGENT_PROVIDER=openhands
OPENHANDS_LLM_BASE_URL=http://host.containers.internal:11434/v1
OPENHANDS_LLM_API_KEY=
# Bare model IDs are routed through LiteLLM's OpenAI-compatible provider.
# OpenCode Go example:
# OPENHANDS_LLM_BASE_URL=https://opencode.ai/zen/go/v1
# OPENHANDS_LLM_MODEL=deepseek-v4-pro
OPENHANDS_LLM_MODEL=model-name
OPENHANDS_MAX_ITERATIONS=30

# Legacy direct OpenAI Responses provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Allow the mock agent provider when no LLM is configured at all (neither the stored settings
# nor the variables above). Off by default: an unconfigured agent run fails with a clear 503
# instead of silently replying with a canned transcript.
AGENT_ALLOW_MOCK_PROVIDER=false
